meta {
  name: Add - Active (two circle sites, two features)
  type: http
  seq: 2
}

post {
  url: {{empBaseUrl}}/addFeatures
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  f: json
  token: {{empApiKey}}
  rollbackOnFailure: true
  features: [{"attributes":{"CaseReference":"EXE/2026/00124","Status":"Active","ApplicationTy":"Exempt activity notification","ApplicantName":"Test Organisation Ltd","Project":"Bruno test - two circles","ActivityTy":"Deposit of a substance or object","SubActTy":"Maintenance","ArticleNo":"Article 17","IAT_URL":"https://example.com/iat/EXE-2026-00124.pdf","ProjStartDate":"2026-09-15","ProjStartDateFormatted":"15 Sep 2026","ProjEndDate":"2026-10-15","ProjEndDateFormatted":"15 Oct 2026","SubDate":"2026-09-15","SubDateFormatted":"15 Sep 2026","PubConsent":"No","Exemptions_URL":"http://localhost:3000/exemption/view-public-details/68c0f1a2b3c4d5e6f7a8b9c1","CoastalOperationsArea":"North East","MarinePlanArea":"North East Inshore"},"geometry":{"rings":[[[-1.3995,55.0198],[-1.3985,55.0198],[-1.3985,55.0188],[-1.3995,55.0188],[-1.3995,55.0198]]],"spatialReference":{"wkid":4326}}},{"attributes":{"CaseReference":"EXE/2026/00124","Status":"Active","ApplicationTy":"Exempt activity notification","ApplicantName":"Test Organisation Ltd","Project":"Bruno test - two circles","ActivityTy":"Deposit of a substance or object","SubActTy":"Maintenance","ArticleNo":"Article 17","IAT_URL":"https://example.com/iat/EXE-2026-00124.pdf","ProjStartDate":"2026-09-15","ProjStartDateFormatted":"15 Sep 2026","ProjEndDate":"2026-10-15","ProjEndDateFormatted":"15 Oct 2026","SubDate":"2026-09-15","SubDateFormatted":"15 Sep 2026","PubConsent":"No","Exemptions_URL":"http://localhost:3000/exemption/view-public-details/68c0f1a2b3c4d5e6f7a8b9c1","CoastalOperationsArea":"North East","MarinePlanArea":"North East Inshore"},"geometry":{"rings":[[[-1.4005,55.0208],[-1.3995,55.0208],[-1.3995,55.0198],[-1.4005,55.0198],[-1.4005,55.0208]]],"spatialReference":{"wkid":4326}}}]
}

docs {
  Two features for one exemption. A manual circle site is sent as its own
  feature so ArcGIS renders a centroid per circle, and both features carry
  identical exemption-level attributes - only the geometry differs.

  This is the case a naive stub gets wrong. The backend does
  addResults.map(r => r.objectId) and stores every one, so a stub returning a
  single fixed result silently loses an id and the later status push would
  update only half the exemption.

  Expect: 200, addResults with TWO entries and DISTINCT objectIds.
}
