meta {
  name: Add - Scheduled (single polygon site)
  type: http
  seq: 1
}

post {
  url: {{empBaseUrl}}/addFeatures
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  f: json
  token: {{empApiKey}}
  rollbackOnFailure: true
  features: [{"attributes":{"CaseReference":"EXE/2026/00123","Status":"Scheduled","ApplicationTy":"Exempt activity notification","ApplicantName":"Test Applicant","Project":"Bruno test - scheduled","ActivityTy":"Deposit of a substance or object","SubActTy":"Construction","ArticleNo":"Article 17","IAT_URL":"https://example.com/iat/EXE-2026-00123.pdf","ProjStartDate":"2026-10-01","ProjStartDateFormatted":"1 Oct 2026","ProjEndDate":"2026-11-01","ProjEndDateFormatted":"1 Nov 2026","SubDate":"2026-09-15","SubDateFormatted":"15 Sep 2026","PubConsent":"Yes","Exemptions_URL":"http://localhost:3000/exemption/view-public-details/68c0f1a2b3c4d5e6f7a8b9c0","CoastalOperationsArea":"North East","MarinePlanArea":"North East Inshore"},"geometry":{"rings":[[[-1.3995,55.0198],[-1.3985,55.0198],[-1.3985,55.0188],[-1.3995,55.0188],[-1.3995,55.0198]]],"spatialReference":{"wkid":4326}}}]
}

docs {
  The shape the backend actually sends on submission - every attribute here is
  produced by transformExemptionToEmpRequest.

  Status is the one this ticket changed. Before ML-1500 it was hardcoded
  'Active' even for an exemption starting next month; it now carries the
  exemption's real status.

  Expect: 200, one entry in addResults with an allocated objectId and
  success: true. Note the objectId - request 03 updates it.
}
